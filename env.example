# Never commit real keys, Firebase service-account JSON or passwords to GitHub.
CANBOSO_API_KEY=REPLACE_ON_VERCEL_ONLY
CANBOSO_AUTH_SCHEME=x-api-key
SHOP_MARKUP_PERCENT=0
SHOP_MARKUP_FIXED_VND=20000
FIREBASE_SERVICE_ACCOUNT_JSON=REPLACE_ON_VERCEL_ONLY
SHOP_SESSION_SECRET=REPLACE_ON_VERCEL_ONLY_WITH_A_RANDOM_STRING_AT_LEAST_32_CHARACTERS
TELEGRAM_BOT_TOKEN=REPLACE_ON_VERCEL_ONLY
TELEGRAM_CHAT_ID=REPLACE_ON_VERCEL_ONLY
SHOP_ADMIN_GOOGLE_UID=REPLACE_WITH_FIREBASE_AUTH_GOOGLE_UID

# FAIL-CLOSED: NEVER set true until all checks in README are completed.
SHOP_PURCHASES_ENABLED=false
SHOP_WALLET_RULES_SECURED=false
SHOP_SUPPLIER_PURCHASE_CONFIRMED=false
SHOP_ALLOW_LEGACY_CHECKOUT=false
SHOP_ALLOW_LEGACY_DELIVERY_ACCESS=false

# Optional ONLY if CanBoSo confirms which field exists in PurchaseRequest.
# CANBOSO_PURCHASE_EMAIL_FIELD=customer_email

# V5.2.3 TEST ONLY. Do not send real bank funds. No real wallet credit is implemented.
WALLET_SANDBOX_ENABLED=false
SEPAY_WEBHOOK_SECRET=REPLACE_ON_VERCEL_ONLY
SEPAY_RECEIVING_ACCOUNT_NUMBER=REPLACE_WITH_SEPAY_TEST_ACCOUNT
SEPAY_SANDBOX_ACCOUNT_NUMBER=REPLACE_WITH_SAME_SEPAY_TEST_ACCOUNT
