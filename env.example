# KITPHAN-MMO V7 (Release Candidate) — CONFIGURE SECRETS ONLY IN VERCEL.
# This file is a guide. Never put real secrets in source or GitHub.

# Firebase Admin SDK / exclusive main Admin Google UID
FIREBASE_SERVICE_ACCOUNT_JSON=VERCEL_SECRET_JSON_ONLY
MAIN_ADMIN_GOOGLE_UID=FIREBASE_MAIN_ADMIN_UID
MAIN_ADMIN_USERNAME=adminkit

# CanBoSo buyer API - read catalog first; purchase needs verified seller wallet & schema
CANBOSO_API_KEY=VERCEL_SECRET_ONLY
CANBOSO_AUTH_SCHEME=x-api-key
SHOP_USD_TO_VND=0
# If a SKU requires an email, confirm exact PurchaseRequest field before using it:
# CANBOSO_PURCHASE_EMAIL_FIELD=recipient_email

# CANONICAL MONEY ledger = live_deposits_v1; historical users.balance is never spendable.
MB_BANK_ACCOUNT_NUMBER=MB_ACCOUNT_NUMBER_ONLY_ON_VERCEL
MB_BANK_ACCOUNT_NAME=VERIFIED_BANK_OWNER_NAME
SEPAY_READ_API_TOKEN=VERCEL_SECRET_ONLY
SEPAY_LIVE_WEBHOOK_SECRET=VERCEL_SECRET_ONLY_DIFFERENT_FROM_TEST
SEPAY_LIVE_RECORDING_ENABLED=false
LIVE_DEPOSITS_ENABLED=false
# Keep an explicit UID allowlist during rollout; never start with *.
LIVE_DEPOSITS_ALLOWED_UIDS=MAIN_ADMIN_UID_ONLY_FOR_PILOT

# Manual Admin credit/debit is OFF by default; requires verified Firebase UID + audit.
ADMIN_WALLET_ADJUSTMENTS_ENABLED=false

# Supplier checkout is OFF until tests and one controlled purchase are verified.
SHOP_PURCHASES_ENABLED=false
SHOP_WALLET_RULES_SECURED=false
SHOP_SUPPLIER_PURCHASE_CONFIRMED=false
SHOP_PURCHASE_ALLOWED_UIDS=MAIN_ADMIN_UID_ONLY_FOR_PILOT
# Default retail margin is EXACTLY +20,000 VND/product (after rounding provider VND cost).
# Admin can override product markup from /admin-finance.html, each change audited.

# Legacy isolation — keep disabled and preserve data without transfer.
ACCOUNT_WALLET_RECONCILED=false
ACCOUNT_ADMIN_WALLET_ENABLED=false
SHOP_ALLOW_LEGACY_CHECKOUT=false
SHOP_ALLOW_LEGACY_DELIVERY_ACCESS=false
WALLET_SANDBOX_ENABLED=false
V55_ADMIN_QR_PREVIEW_ENABLED=false

# Historical test-webhook configuration only, if needed for isolated old tests:
# SEPAY_WEBHOOK_SECRET=TEST_SECRET_ONLY
# SEPAY_SANDBOX_ACCOUNT_NUMBER=TEST_ACCOUNT_ONLY

# Optional legacy notifications/session settings (keep existing Vercel values):
# SHOP_SESSION_SECRET=SECRET
# TELEGRAM_BOT_TOKEN=SECRET
# TELEGRAM_CHAT_ID=CHAT_ID
