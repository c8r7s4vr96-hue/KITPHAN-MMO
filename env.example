# Never commit real keys, Firebase service-account JSON or passwords to GitHub.
CANBOSO_API_KEY=REPLACE_ON_VERCEL_ONLY
CANBOSO_AUTH_SCHEME=x-api-key
SHOP_MARKUP_PERCENT=0
SHOP_MARKUP_FIXED_VND=20000
FIREBASE_SERVICE_ACCOUNT_JSON=REPLACE_ON_VERCEL_ONLY
SHOP_SESSION_SECRET=REPLACE_ON_VERCEL_ONLY_WITH_A_RANDOM_STRING_AT_LEAST_32_CHARACTERS
TELEGRAM_BOT_TOKEN=REPLACE_ON_VERCEL_ONLY
TELEGRAM_CHAT_ID=REPLACE_ON_VERCEL_ONLY
SHOP_ADMIN_GOOGLE_UID=REPLACE_WITH_FIREBASE_AUTH_GOOGLE_UID

# FAIL-CLOSED: NEVER set true until all checks in README are completed.
SHOP_PURCHASES_ENABLED=false
SHOP_WALLET_RULES_SECURED=false
SHOP_SUPPLIER_PURCHASE_CONFIRMED=false
SHOP_ALLOW_LEGACY_CHECKOUT=false
SHOP_ALLOW_LEGACY_DELIVERY_ACCESS=false

# Optional ONLY if CanBoSo confirms which field exists in PurchaseRequest.
# CANBOSO_PURCHASE_EMAIL_FIELD=customer_email

# V5.2.3 TEST ONLY. Do not send real bank funds. No real wallet credit is implemented.
WALLET_SANDBOX_ENABLED=false
SEPAY_WEBHOOK_SECRET=REPLACE_ON_VERCEL_ONLY
SEPAY_RECEIVING_ACCOUNT_NUMBER=REPLACE_WITH_SEPAY_TEST_ACCOUNT
SEPAY_SANDBOX_ACCOUNT_NUMBER=REPLACE_WITH_SAME_SEPAY_TEST_ACCOUNT

# V5.4 LIVE SAFE PREPARATION — do not enable live payments to customers.
# Live HMAC secret must differ from the Test mode webhook secret.
# NEVER put a real bank account or secret into source code.
SEPAY_LIVE_RECORDING_ENABLED=false
SEPAY_LIVE_WEBHOOK_SECRET=REPLACE_WITH_DISTINCT_LIVE_HMAC_SECRET_ON_VERCEL_ONLY
MB_BANK_ACCOUNT_NUMBER=REPLACE_WITH_REAL_MB_BANK_NUMBER_ON_VERCEL_ONLY
# Informational only: no customer-facing QR is generated in V5.3 preparation.
# CRITICAL: There is no LIVE wallet credit in this version.
ACCOUNT_WALLET_RECONCILED=false
ACCOUNT_ADMIN_WALLET_ENABLED=false
SHOP_PURCHASES_ENABLED=false
SHOP_WALLET_RULES_SECURED=false
SHOP_SUPPLIER_PURCHASE_CONFIRMED=false

# V5.4 provides ONLY nonpayable customer previews. There is NO live deposit opening flag.
# Customer-specific drafts are always payable:false, credited:false, qrAvailable:false.
# DO NOT set SEPAY_LIVE_RECORDING_ENABLED=true to try customer deposits.

# V5.5: QR is NEVER returned to customers. Admin QR preview is OFF by default.
MB_BANK_ACCOUNT_NAME=REPLACE_WITH_ACCOUNT_OWNER_NAME_ON_VERCEL_ONLY
V55_ADMIN_QR_PREVIEW_ENABLED=false
# NEVER enable V55_ADMIN_QR_PREVIEW_ENABLED while testing customer deposits.
# A QR created for a real MB Bank number can transfer real money, even in admin preview.

# V6.2 LIVE deposits — add these to Vercel Production ONLY after reconciliation tests.
# LIVE_DEPOSITS_ENABLED=false
# MAIN_ADMIN_GOOGLE_UID=FIREBASE_AUTH_ADMIN_UID
# LIVE_DEPOSITS_ALLOWED_UIDS=FIREBASE_AUTH_ADMIN_UID
# SEPAY_READ_API_TOKEN=SERVER_SIDE_ONLY
# This whitelist defaults to MAIN_ADMIN_GOOGLE_UID when omitted.
# Never use LIVE_DEPOSITS_ALLOWED_UIDS=* before a verified customer rollout.
